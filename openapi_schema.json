{
  "openapi": "3.0.0",
  "info": {
    "title": "OCR Imágenes Siniestros",
    "version": "1.0.0",
    "description": "API para extraer datos de documentos (licencia de conducir y cédula de identidad) usando visión por IA"
  },
  "paths": {
    "/procesar-licencia": {
      "post": {
        "summary": "Extrae datos de una licencia de conducir chilena desde una imagen en S3",
        "description": "Lee la imagen de la licencia de conducir desde S3 usando el session_id y lado (anverso/reverso). Extrae campos como RUT, nombres, apellidos, clase de licencia, fechas, municipalidad y guarda el resultado en DynamoDB.",
        "operationId": "procesarLicencia",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "description": "ID de sesión del usuario (ej: sess_1782498768658_1bd49178-)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lado",
            "in": "query",
            "description": "Lado de la licencia a procesar: anverso o reverso",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["anverso", "reverso"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos extraídos de la licencia exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "lado": { "type": "string" },
                    "datos": {
                      "type": "object",
                      "properties": {
                        "rut": { "type": "string" },
                        "apellidos": { "type": "string" },
                        "nombres": { "type": "string" },
                        "clase_licencia": { "type": "string" },
                        "fecha_emision": { "type": "string" },
                        "fecha_vencimiento": { "type": "string" },
                        "municipalidad": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Parámetros faltantes" },
          "404": { "description": "Imagen no encontrada en S3" }
        }
      }
    },
    "/procesar-cedula-identidad": {
      "post": {
        "summary": "Extrae datos de una cédula de identidad chilena desde una imagen en S3",
        "description": "Lee la imagen de la cédula de identidad desde S3 usando el session_id y lado (anverso/reverso). Extrae campos como Run, nombres, apellidos, nacionalidad, sexo, fecha de nacimiento, profesión y guarda el resultado en DynamoDB.",
        "operationId": "procesarCedulaIdentidad",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "description": "ID de sesión del usuario (ej: sess_1782498768658_1bd49178-)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lado",
            "in": "query",
            "description": "Lado de la cédula a procesar: anverso o reverso",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["anverso", "reverso"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos extraídos de la cédula exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "lado": { "type": "string" },
                    "datos": {
                      "type": "object",
                      "properties": {
                        "Apellidos": { "type": "string" },
                        "Nombres": { "type": "string" },
                        "Nacionalidad": { "type": "string" },
                        "Sexo": { "type": "string" },
                        "Fecha_Nacimiento": { "type": "string" },
                        "Numero_Documento": { "type": "string" },
                        "Fecha_Emision": { "type": "string" },
                        "Fecha_vencimiento": { "type": "string" },
                        "Run": { "type": "string" },
                        "Nacio_en": { "type": "string" },
                        "Profesion": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Parámetros faltantes" },
          "404": { "description": "Imagen no encontrada en S3" }
        }
      }
    }
  }
}
